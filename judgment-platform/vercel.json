{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/upload", "dest": "api/index.py" },
    { "src": "/cases/(.*)", "dest": "api/index.py" },
    { "src": "/cases", "dest": "api/index.py" },
    { "src": "/review/(.*)", "dest": "api/index.py" },
    { "src": "/dashboard/(.*)", "dest": "api/index.py" },
    { "src": "/stream/(.*)", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/docs", "dest": "api/index.py" },
    { "src": "/openapi.json", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
