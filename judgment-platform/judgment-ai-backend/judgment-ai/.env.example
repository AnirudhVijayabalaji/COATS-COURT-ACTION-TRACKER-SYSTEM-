# LLM & AI Providers
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_ADK_MODEL=gemini-2.0-flash-lite
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database Configuration (leave blank for default SQLite)
# Supabase/PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# PDF & OCR Settings
OCR_ENABLED=true
ALLOWED_ORIGINS=*

# Storage settings
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Celery / Redis Async Task Queue (Optional)
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & Security
DEV_AUTH_ENABLED=true
JWT_SECRET_KEY=supersecretjwtkey_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CLERK_JWKS_URL=
NEXTAUTH_SECRET=
